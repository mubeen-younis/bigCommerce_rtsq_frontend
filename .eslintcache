";\r\n\r\nexport const getServices = () => {\r\n    const token = '';\r\n    const config = {\r\n        headers: { \r\n            'Access-Control-Allow-Origin': '*',\r\n            'Content-type': 'application/json',\r\n         } //Authorization: `Bearer ${token}`\r\n    };\r\n    const data = {\r\n        shop: 'dev-azm-1.mybigcommerce.com'\r\n    }\r\n\r\n    return dispatch => {\r\n        axios.get(`${process.env.REACT_APP_ENITURE_API_URL}/get_carrier_services`, {\r\n            data\r\n        })\r\n        .then(({data}) => {\r\n            if (data.data.length > 0) {\r\n                let carrierServices = [];\r\n                data.data.map((value, index) => {\r\n                    carrierServices.push({\r\n                      key: value.speed_freight_carrierSCAC,\r\n                      sr_no: index,\r\n                      carrier_name: value.speed_freight_carrierName,\r\n                      carrier_logo: <img style={{ height: '40px' }} src={`../../Carrier_Logos/${value.carrier_logo}`} alt={value.speed_freight_carrierName} />,\r\n                    });\r\n                  })\r\n                dispatch({\r\n                    type: 'GET_SERVICES',\r\n                    payload: carrierServices\r\n                })\r\n            }\r\n            dispatch({\r\n                type: 'SKELETON_LOADING',\r\n                payload: false\r\n            })\r\n        })\r\n        .catch((error) => {\r\n\r\n        })\r\n    }\r\n}","D:\\x73\\htdocs\\master\\src\\tabs_layout\\tabs.js",[],"D:\\x73\\htdocs\\master\\src\\components\\ProductSettingsComponent.js",["70"],"D:\\x73\\htdocs\\master\\src\\components\\CarriersComponent.js",[],"D:\\x73\\htdocs\\master\\src\\reportWebVitals.js",[],"D:\\x73\\htdocs\\master\\src\\partials\\SideMenu.js",["71"],"D:\\x73\\htdocs\\master\\src\\components\\Pages\\ShippingCarriersComponent.js",[],"D:\\x73\\htdocs\\master\\src\\Utilities\\AlertMessage.js",["72"],"D:\\x73\\htdocs\\master\\src\\components\\Pages\\WweL