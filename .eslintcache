vComponent from '../components/Pages/ImportCsvComponent';\r\nimport UserGuideComponent from '../components/Pages/UserGuideComponent';\r\nimport AlertMessage from \"../Utilities/AlertMessage\";\r\n\r\nconst { TabPane } = Tabs;\r\nfunction callback(key) {\r\n  console.log(key);\r\n}\r\n\r\nfunction TabsLayout(){\r\n    return(\r\n        <>\r\n            \r\n            <Tabs className={\"tabs-wrp\"} onChange={callback} type=\"card\">\r\n                <TabPane tab=\"Connection Settinngs\" key=\"1\">\r\n                    <AlertMessage />\r\n                    <ConnectionSettingsComponent />\r\n                </TabPane>\r\n                <TabPane tab=\"Carriers\" key=\"2\">\r\n                    <AlertMessage />\r\n                    <CarriersComponent />\r\n                </TabPane>\r\n                <TabPane tab=\"Warehouse\" key=\"3\">\r\n                    <AlertMessage />\r\n                    <WarehouseComponent />\r\n                </TabPane>\r\n                <TabPane tab=\"Quote Settings\" key=\"4\">\r\n                    <AlertMessage />\r\n                    <QuoteSettingsComponentWwe />\r\n                </TabPane>\r\n                {/* <TabPane tab=\"Import CSV\" key=\"5\">\r\n                    <AlertMessage />\r\n                    <ImportCsvComponent />\r\n                </TabPane>\r\n                <TabPane tab=\"Box Sizes\" key=\"7\">\r\n                    <BoxSizesComponent />\r\n                </TabPane> */}\r\n                <TabPane tab=\"User Guide\" key=\"6\">\r\n                    <UserGuideComponent />\r\n                </TabPane>\r\n            </Tabs>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default TabsLayout;","D:\\bigCommerce-git\\big-commerce-app\\frontend\\src\\components\\Pages\\WweLtl\\QuoteSettingsComponentWwe.js",["95","96","97","98","99","100","101","102","103","104","105"],"D:\\bigCommerce-git\\big-commerce-app\\frontend\\src\\components\\Pages\\WweLtl\\ConnectionSettingsComponent.js",[],"D:\\bigComm