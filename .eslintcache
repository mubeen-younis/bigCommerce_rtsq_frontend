">Save Settings</Button>\r\n                            </Space>\r\n                        </Form.Item>\r\n                    </Col>\r\n                </Row>\r\n            </Form>\r\n        </Fragment>\r\n    );\r\n}\r\n\r\n\r\n\r\nconst mapStateToProps = (state) => {\r\n    return {\r\n      quoteSettings: state.quoteSettings\r\n    }\r\n}\r\n\r\nconst mapDispatchToProps = (dispatch) => {\r\n    return {\r\n        postData: (data) => dispatch(postData(data, 'GET_QUOTE_SETTINGS', 'submit_quote_settings')),\r\n        getSettings: () => dispatch(getQuoteSettings())\r\n    }\r\n  }\r\n  \r\nexport default connect(mapStateToProps, mapDispatchToProps)(QuoteSettingsComponentWwe);","D:\\bigCommerce-git\\big-commerce-app\\frontend\\src\\Actions\\Carriers.js",["57","58","59"],"import axios  from \"axios\";\r\n\r\nexport const getServices = () => {\r\n    const token = '';\r\n    const config = {\r\n        headers: { \r\n            'Access-Control-Allow-Origin': '*',\r\n            'Content-type': 'application/json',\r\n         } //Authorization: `Bearer ${token}`\r\n    };\r\n    const data = {\r\n        shop: 'dev-azm-1.mybigcommerce.com'\r\n    }\r\n\r\n    return dispatch => {\r\n        axios.get(`${process.env.REACT_APP_ENITURE_API_URL}/get_carrier_services`, {\r\n            data\r\n        })\r\n        .then(({data}) => {\r\n            if (data.data.length > 0) {\r\n                let carrierServices = [];\r\n                data.data.map((value, index) => {\r\n                    carrierServices.push({\r\n                      key: value.speed_freight_carrierSCAC,\r\n                      sr_no: index+1,\r\n                      carrier_name: value.speed_freight_carrierName,\r\n                      carrier_logo: <img style={{ height: '40px' }} src={`../../Carrier_Logos/${value.carrier_logo}`} alt={value.speed_freight_carrierName} />,\r\n                    });\r\n                  })\r\n                dispatch({\r\n                    type: 'GET_SERVICES',\r\n                    payload: carrierServices\r\n                })\r\n            }\r\n            dispatch({\r\n                type: 'SKELETON_LOADING',\r\n                payload: false\r\n            })\r\n        })\r\n        .catch((error) => {\r\n\r\n        })\r\n    }\r\n}","D:\\bigCommerce-git\\big-commerce-app\\frontend\\src\\reportWebVitals.js",[],"D:\\bigCommerce-git\\big-commerce-app\\frontend\\src\\Actions\\Action.js",["60","61","62"],"D:\\bigCommerce-git\\big-commerce-app\\frontend\\src\\components\\CarriersComponent.js",[],{"ruleId":"63","severity":1,"message":"64","line":18,"column":10,"nodeType":"65","messageId":"66","endLine":18,"endColumn":22},{"ruleId":"63","severity":1,"message":"67","line":126,"column":20,"nodeType":"65","messageId":"66","endLine":126,"endColumn":32},{"ruleId":"68","replacedBy":"69"},{"ruleId":"70","replacedBy":"71"},{"ruleId":"63","severity":1,"message":"72","line":23,"column":12,"nodeType":"65","messageId":"66","endLine":23,"endColumn":20},{"ruleId":"63","severity":1,"message":"73","line":23,"column":22,"nodeType":"65","messageId":"66","endLine":23,"endColumn":41},{"ruleId":"74","severity":1,"message":"75","line":91,"column":34,"nodeType":"76","messageId":"77","endLine":91,"endColumn":36},{"ruleId":"74","severity":1,"message":"75","line":91,"column":55,"nodeType":"76","messageId":"77","endLine":91,"endColumn":57},{"ruleId":"74","severity":1,"message":"75","line":120,"column":34,"nodeType":"76","messageId":"77","endLine":120,"endColumn":36},{"ruleId":"74","severity":1,"message":"75","line":120,"column":55,"nodeType":"76","messageId":"77","endLine":120,"endColumn":57},{"ruleId":"78","severity":1,"message":"79","line":172,"column":82,"nodeType":"80","endLine":172,"endColumn":127},{"ruleId":"78","severity":1,"message":"79","line":201,"column":82,"nodeType":"80","endLine":201,"endColumn":127},{"ruleId":"78","severity":1,"message":"79","line":209,"column":82,"nodeType":"80","endLine":209,"endColumn":127},{"ruleId":"78",